 x17fgdl5 x1n2onr6 x1qg1ob xxx6ivz x1gx27l9 x14fraq8 x2nxwck xb3dwbw"><span data-testid="tail-out" aria-hidden="true" data-icon="tail-out" class="x1lliihq x18gnavp x10l6tqk x13vifvy x1xc55vz xupqr0c xgvahye x1fa4crm"><svg viewBox="0 0 8 13" height="13" width="8" preserveAspectRatio="xMidYMid meet" version="1.1" x="0px" y="0px" enable-background="new 0 0 8 13"><title>tail-out</title><path class="x5eawxs" d="M5.188,1H0v11.193l6.467-8.625 C7.526,2.156,6.958,1,5.188,1z"></path><path fill="currentColor" d="M5.188,0H0v11.193l6.467-8.625C7.526,1.156,6.958,0,5.188,0z"></path></svg></span><div class="x1liijdw xelbjmh x16pgt24 x1n2onr6 x12xzxwr x1g5lz36 x17un8ov xgdw1sx false false"><div><span aria-label="You:"></span><div><div class="x9f619 x1hx0egp x1yrsyyn xodvfiu xct3hqd xwib8y2"><div class="copyable-text" data-pre-plain-text="[12:07 AM, 9/10/2026] SHIVA: "><div class="x1n2onr6 x1mzt3pk x126k92a x6ikm8r x10wlt62"><span data-testid="selectable-text" dir="ltr" class="x1f6kntn xjb2p0i x8r4c90 xo1l8bm x1ic7a3i x12xpedu xnpuxes selectable-text copyable-text" style="min-height: 0px;"><span class="x1lliihq">function updateCountdown(){
</span><span class="x1lliihq">
</span><span class="x1lliihq">  const now = new Date();
</span><span class="x1lliihq">
</span><span class="x1lliihq">  // Correct Ganesh Dates - 100% Original
</span><span class="x1lliihq">  const ganeshDates = [
</span><span class="x1lliihq">    new Date(2026, 8, 14, 0, 0, 0),
</span><span class="x1lliihq">    new Date(2027, 8, 4, 0, 0, 0),
</span><span class="x1lliihq">    new Date(2028, 7, 23, 0, 0, 0),
</span><span class="x1lliihq">    new Date(2029, 8, 12, 0, 0, 0),
</span><span class="x1lliihq">    new Date(2030, 8, 2, 0, 0, 0)
</span><span class="x1lliihq">  ];
</span><span class="x1lliihq">
</span><span class="x1lliihq">  let target = ganeshDates[0];
</span><span class="x1lliihq">  for(let i=0; i&lt;ganeshDates.length; i++){
</span><span class="x1lliihq">    if(now &lt; ganeshDates[i]){
</span><span class="x1lliihq">      target = ganeshDates[i];
</span><span class="x1lliihq">      break;
</span><span class="x1lliihq">    }
</span><span class="x1lliihq">  }
</span><span class="x1lliihq">  // 2030 tarvata kuda Sep 14 ki vellela backup
</span><span class="x1lliihq">  if(now &gt;= ganeshDates[ganeshDates.length-1]){
</span><span class="x1lliihq">    let nextYear = now.getFullYear() + 1;
